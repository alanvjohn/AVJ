rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.keys().hasOnly(['name', 'email', 'message', 'timestamp'])
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'timestamp'])
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.timestamp is string;

      allow read: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com';
      allow update, delete: if false;
    }

    match /siteSettings/appearance {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com';
    }

    match /adminLoginLogs/{logId} {
      allow create: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp is string;

      allow read: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com';
      allow update, delete: if false;
    }
  }
}
