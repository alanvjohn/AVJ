rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name',
        'email',
        'message',
        'timestamp'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 100
      && request.resource.data.email is string
      && request.resource.data.email.size() > 3
      && request.resource.data.email.size() <= 254
      && request.resource.data.message is string
      && request.resource.data.message.size() > 0
      && request.resource.data.message.size() <= 5000
      && request.resource.data.timestamp is string;

      allow read: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com';
      allow update, delete: if false;
    }

    match /siteSettings/appearance {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com'
        && request.resource.data.keys().hasOnly([
          'heroBackground',
          'loaderStyle',
          'asciiPreset',
          'asciiCharacters',
          'asciiMouseInteraction',
          'asciiIntro',
          'asciiLightMode',
          'themeToastX',
          'themeToastY',
          'refreshAt',
          'updatedAt'
        ])
        && (!('heroBackground' in request.resource.data)
          || request.resource.data.heroBackground in ['ascii', 'grid', 'plain'])
        && (!('loaderStyle' in request.resource.data)
          || request.resource.data.loaderStyle in [
          'letter-glitch',
          'random',
          'random-all',
          'shape-grid',
          'dot-grid',
          'classic'
        ])
        && (!('asciiPreset' in request.resource.data)
          || request.resource.data.asciiPreset in [
          'atmosphere',
          'lagoon',
          'rose',
          'corona',
          'violet'
        ])
        && (!('asciiCharacters' in request.resource.data)
          || request.resource.data.asciiCharacters in ['classic', 'letters', 'symbols'])
        && (!('asciiMouseInteraction' in request.resource.data)
          || request.resource.data.asciiMouseInteraction is bool)
        && (!('asciiIntro' in request.resource.data)
          || request.resource.data.asciiIntro is bool)
        && (!('asciiLightMode' in request.resource.data)
          || request.resource.data.asciiLightMode is bool)
        && (!('themeToastX' in request.resource.data)
          || request.resource.data.themeToastX is number)
        && (!('themeToastY' in request.resource.data)
          || request.resource.data.themeToastY is number)
        && (!('refreshAt' in request.resource.data)
          || request.resource.data.refreshAt is timestamp)
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt is timestamp);
    }

    match /adminLoginLogs/{logId} {
      allow create: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com'
        && request.resource.data.keys().hasOnly([
          'email',
          'uid',
          'timestamp'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.timestamp is string;
      allow read: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com';
      allow update, delete: if false;
    }
  }
}
