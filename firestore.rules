rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name',
        'email',
        'message',
        'timestamp'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 100
      && request.resource.data.email is string
      && request.resource.data.email.size() > 3
      && request.resource.data.email.size() <= 254
      && request.resource.data.message is string
      && request.resource.data.message.size() > 0
      && request.resource.data.message.size() <= 5000
      && request.resource.data.timestamp is string;

      allow read: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com';
      allow update, delete: if false;
    }

    match /siteSettings/appearance {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com'
        && request.resource.data.keys().hasOnly([
          'lenis',
          'revealAnimations',
          'cursor',
          'reactBitsCards',
          'heroBackground',
          'voxelArcInteractive',
          'voxelArcPreset',
          'voxelArcColor',
          'voxelArcAccent',
          'voxelArcBackground',
          'voxelArcDensity',
          'voxelArcSize',
          'voxelArcRoundness',
          'voxelArcTilt',
          'voxelArcHorizon',
          'voxelArcCurvature',
          'voxelArcWaveHeight',
          'voxelArcWaveLength',
          'voxelArcSpeed',
          'voxelArcTurbulence',
          'voxelArcBrightness',
          'voxelArcGlow',
          'voxelArcHaze',
          'voxelArcBloom',
          'voxelArcFocus',
          'voxelArcAperture',
          'voxelArcGrain',
          'voxelArcRipples',
          'voxelArcIntro',
          'voxelArcPaused',
          'voxelArcWaveStrength',
          'voxelArcCellSize',
          'voxelArcHue',
          'astralShellInteractive',
          'astralShellDraggable',
          'astralShellClickPulse',
          'astralShellPaused',
          'astralShellPreset',
          'astralShellBackground',
          'astralShellNetworkColor',
          'astralShellHighlightColor',
          'astralShellPointCount',
          'astralShellConnections',
          'astralShellReach',
          'astralShellClustering',
          'astralShellChords',
          'astralShellRadius',
          'astralShellOriginX',
          'astralShellOriginY',
          'astralShellRotationSpeed',
          'astralShellScale',
          'astralShellNodeSize',
          'astralShellDepthFade',
          'astralShellLineOpacity',
          'astralShellSpin',
          'astralShellTilt',
          'astralShellHoverRadius',
          'astralShellHoverBoost',
          'astralShellPulseSpeed',
          'astralShellSeed',
          'terminalRainCharacters',
          'terminalRainPreset',
          'terminalRainMode',
          'terminalRainTrailColor',
          'terminalRainHeadColor',
          'terminalRainBackground',
          'terminalRainFontSize',
          'terminalRainSpacing',
          'terminalRainTrailLength',
          'terminalRainSpeed',
          'terminalRainDensity',
          'terminalRainVariance',
          'terminalRainAngle',
          'terminalRainShuffle',
          'terminalRainDepth',
          'terminalRainGlow',
          'terminalRainIntensity',
          'terminalRainSlowRadius',
          'terminalRainSlowStrength',
          'terminalRainBurstSize',
          'terminalRainMirror',
          'terminalRainBulletTime',
          'terminalRainClickBurst',
          'terminalRainInteractive',
          'terminalRainCascade',
          'terminalRainResolution',
          'loaderStyle',
          'asciiPreset',
          'asciiCharacters',
          'asciiCustomCharacters',
          'asciiRandomCharacters',
          'asciiTextMode',
          'asciiText',
          'asciiAnimationSpeed',
          'asciiWaveStrength',
          'asciiColorPreset',
          'asciiMouseInteraction',
          'asciiDesktopCellSize',
          'asciiMobileCellSize',
          'asciiDesktopMouseInteraction',
          'asciiMobileMouseInteraction',
          'asciiIntro',
          'asciiLightMode',
          'lenisLerp',
          'lenisWheelMultiplier',
          'lenisTouchMultiplier',
          'lenisSyncTouch',
          'lenisSmoothWheel',
          'motionPreset',
          'toolkitStyle',
          'toolkitChipMotion',
          'accentPreset',
          'showHeroProfile',
          'showHeroActions',
          'heroEyebrow',
          'heroTitle',
          'heroSubtitle',
          'contactNotifications',
          'refreshAt',
          'updatedAt'
        ])
        && (!('heroBackground' in request.resource.data)
          || request.resource.data.heroBackground in ['ascii', 'voxel-arc', 'terminal-rain', 'astral-shell', 'grid', 'plain'])
        && (!('voxelArcInteractive' in request.resource.data) || request.resource.data.voxelArcInteractive is bool)
        && (!('voxelArcPreset' in request.resource.data)
          || request.resource.data.voxelArcPreset in ['horizon', 'dusk', 'calm', 'storm', 'dots', 'grid', 'planet'])
        && (!('voxelArcColor' in request.resource.data)
          || (request.resource.data.voxelArcColor is string && request.resource.data.voxelArcColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('voxelArcAccent' in request.resource.data)
          || (request.resource.data.voxelArcAccent is string && request.resource.data.voxelArcAccent.matches('^#[0-9a-fA-F]{6}$')))
        && (!('voxelArcBackground' in request.resource.data)
          || (request.resource.data.voxelArcBackground is string && request.resource.data.voxelArcBackground.matches('^#[0-9a-fA-F]{6}$')))
        && (!('voxelArcDensity' in request.resource.data)
          || (request.resource.data.voxelArcDensity is number
            && request.resource.data.voxelArcDensity >= 0.1
            && request.resource.data.voxelArcDensity <= 1))
        && (!('voxelArcSize' in request.resource.data)
          || (request.resource.data.voxelArcSize is number
            && request.resource.data.voxelArcSize >= 0.2
            && request.resource.data.voxelArcSize <= 1))
        && (!('voxelArcRoundness' in request.resource.data)
          || (request.resource.data.voxelArcRoundness is number
            && request.resource.data.voxelArcRoundness >= 0
            && request.resource.data.voxelArcRoundness <= 1))
        && (!('voxelArcTilt' in request.resource.data)
          || (request.resource.data.voxelArcTilt is number
            && request.resource.data.voxelArcTilt >= 0
            && request.resource.data.voxelArcTilt <= 2))
        && (!('voxelArcHorizon' in request.resource.data)
          || (request.resource.data.voxelArcHorizon is number
            && request.resource.data.voxelArcHorizon >= 0.2
            && request.resource.data.voxelArcHorizon <= 0.8))
        && (!('voxelArcCurvature' in request.resource.data)
          || (request.resource.data.voxelArcCurvature is number
            && request.resource.data.voxelArcCurvature >= 0
            && request.resource.data.voxelArcCurvature <= 1))
        && (!('voxelArcWaveHeight' in request.resource.data)
          || (request.resource.data.voxelArcWaveHeight is number
            && request.resource.data.voxelArcWaveHeight >= 0
            && request.resource.data.voxelArcWaveHeight <= 2))
        && (!('voxelArcWaveLength' in request.resource.data)
          || (request.resource.data.voxelArcWaveLength is number
            && request.resource.data.voxelArcWaveLength >= 0.2
            && request.resource.data.voxelArcWaveLength <= 2))
        && (!('voxelArcSpeed' in request.resource.data)
          || (request.resource.data.voxelArcSpeed is number
            && request.resource.data.voxelArcSpeed >= 0
            && request.resource.data.voxelArcSpeed <= 2))
        && (!('voxelArcTurbulence' in request.resource.data)
          || (request.resource.data.voxelArcTurbulence is number
            && request.resource.data.voxelArcTurbulence >= 0
            && request.resource.data.voxelArcTurbulence <= 1))
        && (!('voxelArcBrightness' in request.resource.data)
          || (request.resource.data.voxelArcBrightness is number
            && request.resource.data.voxelArcBrightness >= 0
            && request.resource.data.voxelArcBrightness <= 2))
        && (!('voxelArcGlow' in request.resource.data)
          || (request.resource.data.voxelArcGlow is number
            && request.resource.data.voxelArcGlow >= 0
            && request.resource.data.voxelArcGlow <= 2))
        && (!('voxelArcHaze' in request.resource.data)
          || (request.resource.data.voxelArcHaze is number
            && request.resource.data.voxelArcHaze >= 0
            && request.resource.data.voxelArcHaze <= 1))
        && (!('voxelArcBloom' in request.resource.data)
          || (request.resource.data.voxelArcBloom is number
            && request.resource.data.voxelArcBloom >= 0
            && request.resource.data.voxelArcBloom <= 1))
        && (!('voxelArcFocus' in request.resource.data)
          || (request.resource.data.voxelArcFocus is number
            && request.resource.data.voxelArcFocus >= 0
            && request.resource.data.voxelArcFocus <= 1))
        && (!('voxelArcAperture' in request.resource.data)
          || (request.resource.data.voxelArcAperture is number
            && request.resource.data.voxelArcAperture >= 0
            && request.resource.data.voxelArcAperture <= 1))
        && (!('voxelArcGrain' in request.resource.data)
          || (request.resource.data.voxelArcGrain is number
            && request.resource.data.voxelArcGrain >= 0
            && request.resource.data.voxelArcGrain <= 1))
        && (!('voxelArcRipples' in request.resource.data)
          || (request.resource.data.voxelArcRipples is number
            && request.resource.data.voxelArcRipples >= 0
            && request.resource.data.voxelArcRipples <= 2))
        && (!('voxelArcIntro' in request.resource.data) || request.resource.data.voxelArcIntro is bool)
        && (!('voxelArcPaused' in request.resource.data) || request.resource.data.voxelArcPaused is bool)
        && (!('voxelArcWaveStrength' in request.resource.data)
          || (request.resource.data.voxelArcWaveStrength is number
            && request.resource.data.voxelArcWaveStrength >= 0
            && request.resource.data.voxelArcWaveStrength <= 14))
        && (!('voxelArcCellSize' in request.resource.data)
          || (request.resource.data.voxelArcCellSize is number
            && request.resource.data.voxelArcCellSize >= 10
            && request.resource.data.voxelArcCellSize <= 32))
        && (!('voxelArcHue' in request.resource.data)
          || (request.resource.data.voxelArcHue is number
            && request.resource.data.voxelArcHue >= 160
            && request.resource.data.voxelArcHue <= 280))
        && (!('astralShellInteractive' in request.resource.data) || request.resource.data.astralShellInteractive is bool)
        && (!('astralShellDraggable' in request.resource.data) || request.resource.data.astralShellDraggable is bool)
        && (!('astralShellClickPulse' in request.resource.data) || request.resource.data.astralShellClickPulse is bool)
        && (!('astralShellPaused' in request.resource.data) || request.resource.data.astralShellPaused is bool)
        && (!('astralShellPreset' in request.resource.data)
          || request.resource.data.astralShellPreset in ['violet', 'cyan', 'mono', 'rose', 'ink', 'lilac'])
        && (!('astralShellBackground' in request.resource.data)
          || (request.resource.data.astralShellBackground is string && request.resource.data.astralShellBackground.matches('^#[0-9a-fA-F]{6}$')))
        && (!('astralShellNetworkColor' in request.resource.data)
          || (request.resource.data.astralShellNetworkColor is string && request.resource.data.astralShellNetworkColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('astralShellHighlightColor' in request.resource.data)
          || (request.resource.data.astralShellHighlightColor is string && request.resource.data.astralShellHighlightColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('astralShellPointCount' in request.resource.data)
          || (request.resource.data.astralShellPointCount is number
            && request.resource.data.astralShellPointCount >= 60
            && request.resource.data.astralShellPointCount <= 2400))
        && (!('astralShellConnections' in request.resource.data)
          || (request.resource.data.astralShellConnections is number
            && request.resource.data.astralShellConnections >= 1
            && request.resource.data.astralShellConnections <= 8))
        && (!('astralShellReach' in request.resource.data)
          || (request.resource.data.astralShellReach is number
            && request.resource.data.astralShellReach >= 0.05
            && request.resource.data.astralShellReach <= 0.5))
        && (!('astralShellClustering' in request.resource.data)
          || (request.resource.data.astralShellClustering is number
            && request.resource.data.astralShellClustering >= 0
            && request.resource.data.astralShellClustering <= 1))
        && (!('astralShellChords' in request.resource.data)
          || (request.resource.data.astralShellChords is number
            && request.resource.data.astralShellChords >= 0
            && request.resource.data.astralShellChords <= 1))
        && (!('astralShellRadius' in request.resource.data)
          || (request.resource.data.astralShellRadius is number
            && request.resource.data.astralShellRadius >= 0.2
            && request.resource.data.astralShellRadius <= 0.8))
        && (!('astralShellOriginX' in request.resource.data)
          || (request.resource.data.astralShellOriginX is number
            && request.resource.data.astralShellOriginX >= 0.1
            && request.resource.data.astralShellOriginX <= 0.9))
        && (!('astralShellOriginY' in request.resource.data)
          || (request.resource.data.astralShellOriginY is number
            && request.resource.data.astralShellOriginY >= 0.1
            && request.resource.data.astralShellOriginY <= 0.9))
        && (!('astralShellRotationSpeed' in request.resource.data)
          || (request.resource.data.astralShellRotationSpeed is number
            && request.resource.data.astralShellRotationSpeed >= 0
            && request.resource.data.astralShellRotationSpeed <= 0.008))
        && (!('astralShellScale' in request.resource.data)
          || (request.resource.data.astralShellScale is number
            && request.resource.data.astralShellScale >= 0.2
            && request.resource.data.astralShellScale <= 0.48))
        && (!('astralShellNodeSize' in request.resource.data)
          || (request.resource.data.astralShellNodeSize is number
            && request.resource.data.astralShellNodeSize >= 0.2
            && request.resource.data.astralShellNodeSize <= 2))
        && (!('astralShellDepthFade' in request.resource.data)
          || (request.resource.data.astralShellDepthFade is number
            && request.resource.data.astralShellDepthFade >= 0
            && request.resource.data.astralShellDepthFade <= 1))
        && (!('astralShellLineOpacity' in request.resource.data)
          || (request.resource.data.astralShellLineOpacity is number
            && request.resource.data.astralShellLineOpacity >= 0.1
            && request.resource.data.astralShellLineOpacity <= 1))
        && (!('astralShellSpin' in request.resource.data)
          || (request.resource.data.astralShellSpin is number
            && request.resource.data.astralShellSpin >= 0
            && request.resource.data.astralShellSpin <= 2))
        && (!('astralShellTilt' in request.resource.data)
          || (request.resource.data.astralShellTilt is number
            && request.resource.data.astralShellTilt >= 0
            && request.resource.data.astralShellTilt <= 45))
        && (!('astralShellHoverRadius' in request.resource.data)
          || (request.resource.data.astralShellHoverRadius is number
            && request.resource.data.astralShellHoverRadius >= 0.05
            && request.resource.data.astralShellHoverRadius <= 0.5))
        && (!('astralShellHoverBoost' in request.resource.data)
          || (request.resource.data.astralShellHoverBoost is number
            && request.resource.data.astralShellHoverBoost >= 0
            && request.resource.data.astralShellHoverBoost <= 2))
        && (!('astralShellPulseSpeed' in request.resource.data)
          || (request.resource.data.astralShellPulseSpeed is number
            && request.resource.data.astralShellPulseSpeed >= 0
            && request.resource.data.astralShellPulseSpeed <= 3))
        && (!('astralShellSeed' in request.resource.data)
          || (request.resource.data.astralShellSeed is number
            && request.resource.data.astralShellSeed >= 0
            && request.resource.data.astralShellSeed <= 100))
        && (!('terminalRainCharacters' in request.resource.data)
          || (request.resource.data.terminalRainCharacters is string
            && request.resource.data.terminalRainCharacters.size() >= 2
            && request.resource.data.terminalRainCharacters.size() <= 64))
        && (!('terminalRainPreset' in request.resource.data)
          || request.resource.data.terminalRainPreset in ['aurora', 'matrix', 'amber', 'binary', 'storm', 'drizzle', 'mono'])
        && (!('terminalRainMode' in request.resource.data)
          || request.resource.data.terminalRainMode in ['auto', 'glow', 'ink'])
        && (!('terminalRainTrailColor' in request.resource.data)
          || (request.resource.data.terminalRainTrailColor is string && request.resource.data.terminalRainTrailColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('terminalRainHeadColor' in request.resource.data)
          || (request.resource.data.terminalRainHeadColor is string && request.resource.data.terminalRainHeadColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('terminalRainBackground' in request.resource.data)
          || (request.resource.data.terminalRainBackground is string && request.resource.data.terminalRainBackground.matches('^#[0-9a-fA-F]{6}$')))
        && (!('terminalRainFontSize' in request.resource.data)
          || (request.resource.data.terminalRainFontSize is number
            && request.resource.data.terminalRainFontSize >= 10
            && request.resource.data.terminalRainFontSize <= 32))
        && (!('terminalRainSpacing' in request.resource.data)
          || (request.resource.data.terminalRainSpacing is number
            && request.resource.data.terminalRainSpacing >= 0.5
            && request.resource.data.terminalRainSpacing <= 2))
        && (!('terminalRainTrailLength' in request.resource.data)
          || (request.resource.data.terminalRainTrailLength is number
            && request.resource.data.terminalRainTrailLength >= 4
            && request.resource.data.terminalRainTrailLength <= 32))
        && (!('terminalRainSpeed' in request.resource.data)
          || (request.resource.data.terminalRainSpeed is number
            && request.resource.data.terminalRainSpeed >= 0.2
            && request.resource.data.terminalRainSpeed <= 2))
        && (!('terminalRainDensity' in request.resource.data)
          || (request.resource.data.terminalRainDensity is number
            && request.resource.data.terminalRainDensity >= 0.1
            && request.resource.data.terminalRainDensity <= 1))
        && (!('terminalRainVariance' in request.resource.data)
          || (request.resource.data.terminalRainVariance is number
            && request.resource.data.terminalRainVariance >= 0
            && request.resource.data.terminalRainVariance <= 1))
        && (!('terminalRainAngle' in request.resource.data)
          || (request.resource.data.terminalRainAngle is number
            && request.resource.data.terminalRainAngle >= -30
            && request.resource.data.terminalRainAngle <= 30))
        && (!('terminalRainShuffle' in request.resource.data)
          || (request.resource.data.terminalRainShuffle is number
            && request.resource.data.terminalRainShuffle >= 0
            && request.resource.data.terminalRainShuffle <= 1))
        && (!('terminalRainDepth' in request.resource.data)
          || (request.resource.data.terminalRainDepth is number
            && request.resource.data.terminalRainDepth >= 0
            && request.resource.data.terminalRainDepth <= 1))
        && (!('terminalRainGlow' in request.resource.data)
          || (request.resource.data.terminalRainGlow is number
            && request.resource.data.terminalRainGlow >= 0
            && request.resource.data.terminalRainGlow <= 1))
        && (!('terminalRainIntensity' in request.resource.data)
          || (request.resource.data.terminalRainIntensity is number
            && request.resource.data.terminalRainIntensity >= 0.2
            && request.resource.data.terminalRainIntensity <= 2))
        && (!('terminalRainSlowRadius' in request.resource.data)
          || (request.resource.data.terminalRainSlowRadius is number
            && request.resource.data.terminalRainSlowRadius >= 0
            && request.resource.data.terminalRainSlowRadius <= 300))
        && (!('terminalRainSlowStrength' in request.resource.data)
          || (request.resource.data.terminalRainSlowStrength is number
            && request.resource.data.terminalRainSlowStrength >= 0
            && request.resource.data.terminalRainSlowStrength <= 1))
        && (!('terminalRainBurstSize' in request.resource.data)
          || (request.resource.data.terminalRainBurstSize is number
            && request.resource.data.terminalRainBurstSize >= 0.2
            && request.resource.data.terminalRainBurstSize <= 2))
        && (!('terminalRainMirror' in request.resource.data) || request.resource.data.terminalRainMirror is bool)
        && (!('terminalRainBulletTime' in request.resource.data) || request.resource.data.terminalRainBulletTime is bool)
        && (!('terminalRainClickBurst' in request.resource.data) || request.resource.data.terminalRainClickBurst is bool)
        && (!('terminalRainInteractive' in request.resource.data)
          || request.resource.data.terminalRainInteractive is bool)
        && (!('terminalRainCascade' in request.resource.data)
          || request.resource.data.terminalRainCascade is bool)
        && (!('terminalRainResolution' in request.resource.data)
          || (request.resource.data.terminalRainResolution is number
            && request.resource.data.terminalRainResolution >= 0.25
            && request.resource.data.terminalRainResolution <= 1))
        && (!('lenis' in request.resource.data) || request.resource.data.lenis is bool)
        && (!('revealAnimations' in request.resource.data) || request.resource.data.revealAnimations is bool)
        && (!('cursor' in request.resource.data) || request.resource.data.cursor is bool)
        && (!('reactBitsCards' in request.resource.data) || request.resource.data.reactBitsCards is bool)
        && (!('loaderStyle' in request.resource.data)
          || request.resource.data.loaderStyle in [
          'letter-glitch',
          'random',
          'random-all',
          'shape-grid',
          'dot-grid',
          'classic'
        ])
        && (!('asciiPreset' in request.resource.data)
          || request.resource.data.asciiPreset in [
          'atmosphere',
          'lagoon',
          'rose',
          'corona',
          'violet'
        ])
        && (!('asciiCharacters' in request.resource.data)
          || request.resource.data.asciiCharacters in ['classic', 'letters', 'symbols', 'custom'])
        && (!('asciiCustomCharacters' in request.resource.data)
          || (request.resource.data.asciiCustomCharacters is string
            && request.resource.data.asciiCustomCharacters.size() >= 2
            && request.resource.data.asciiCustomCharacters.size() <= 64))
        && (!('asciiRandomCharacters' in request.resource.data) || request.resource.data.asciiRandomCharacters is bool)
        && (!('asciiTextMode' in request.resource.data) || request.resource.data.asciiTextMode is bool)
        && (!('asciiText' in request.resource.data)
          || (request.resource.data.asciiText is string && request.resource.data.asciiText.size() <= 40))
        && (!('asciiAnimationSpeed' in request.resource.data)
          || (request.resource.data.asciiAnimationSpeed is number
            && request.resource.data.asciiAnimationSpeed >= 0
            && request.resource.data.asciiAnimationSpeed <= 3))
        && (!('asciiWaveStrength' in request.resource.data)
          || (request.resource.data.asciiWaveStrength is number
            && request.resource.data.asciiWaveStrength >= 0
            && request.resource.data.asciiWaveStrength <= 0.3))
        && (!('asciiColorPreset' in request.resource.data)
          || request.resource.data.asciiColorPreset in ['atmosphere', 'lagoon', 'violet', 'rose', 'corona', 'mono', 'cyber', 'ember'])
        && (!('asciiMouseInteraction' in request.resource.data)
          || request.resource.data.asciiMouseInteraction is bool)
        && (!('asciiDesktopCellSize' in request.resource.data)
          || (request.resource.data.asciiDesktopCellSize is number
            && request.resource.data.asciiDesktopCellSize >= 8
            && request.resource.data.asciiDesktopCellSize <= 24))
        && (!('asciiMobileCellSize' in request.resource.data)
          || (request.resource.data.asciiMobileCellSize is number
            && request.resource.data.asciiMobileCellSize >= 10
            && request.resource.data.asciiMobileCellSize <= 32))
        && (!('asciiDesktopMouseInteraction' in request.resource.data)
          || request.resource.data.asciiDesktopMouseInteraction is bool)
        && (!('asciiMobileMouseInteraction' in request.resource.data)
          || request.resource.data.asciiMobileMouseInteraction is bool)
        && (!('asciiIntro' in request.resource.data)
          || request.resource.data.asciiIntro is bool)
        && (!('asciiLightMode' in request.resource.data)
          || request.resource.data.asciiLightMode is bool)
        && (!('lenisLerp' in request.resource.data)
          || (request.resource.data.lenisLerp is number
            && request.resource.data.lenisLerp >= 0.02
            && request.resource.data.lenisLerp <= 0.2))
        && (!('lenisWheelMultiplier' in request.resource.data)
          || (request.resource.data.lenisWheelMultiplier is number
            && request.resource.data.lenisWheelMultiplier >= 0.5
            && request.resource.data.lenisWheelMultiplier <= 2))
        && (!('lenisTouchMultiplier' in request.resource.data)
          || (request.resource.data.lenisTouchMultiplier is number
            && request.resource.data.lenisTouchMultiplier >= 0.5
            && request.resource.data.lenisTouchMultiplier <= 2))
        && (!('lenisSyncTouch' in request.resource.data)
          || request.resource.data.lenisSyncTouch is bool)
        && (!('lenisSmoothWheel' in request.resource.data)
          || request.resource.data.lenisSmoothWheel is bool)
        && (!('motionPreset' in request.resource.data)
          || request.resource.data.motionPreset in ['calm', 'snappy', 'cinematic', 'cyber'])
        && (!('toolkitStyle' in request.resource.data)
          || request.resource.data.toolkitStyle in ['cyber-field', 'signal', 'particles', 'minimal', 'off'])
        && (!('toolkitChipMotion' in request.resource.data)
          || request.resource.data.toolkitChipMotion is bool)
        && (!('accentPreset' in request.resource.data)
          || request.resource.data.accentPreset in ['blue', 'cyan', 'violet', 'rose', 'amber', 'green'])
        && (!('showHeroProfile' in request.resource.data) || request.resource.data.showHeroProfile is bool)
        && (!('showHeroActions' in request.resource.data) || request.resource.data.showHeroActions is bool)
        && (!('heroEyebrow' in request.resource.data)
          || (request.resource.data.heroEyebrow is string && request.resource.data.heroEyebrow.size() <= 120))
        && (!('heroTitle' in request.resource.data)
          || (request.resource.data.heroTitle is string && request.resource.data.heroTitle.size() <= 180))
        && (!('heroSubtitle' in request.resource.data)
          || (request.resource.data.heroSubtitle is string && request.resource.data.heroSubtitle.size() <= 500))
        && (!('contactNotifications' in request.resource.data) || request.resource.data.contactNotifications is bool)
        && (!('refreshAt' in request.resource.data)
          || request.resource.data.refreshAt is timestamp)
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt is timestamp);
    }

    match /adminLoginLogs/{logId} {
      allow create: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com'
        && request.resource.data.keys().hasOnly([
          'email',
          'uid',
          'timestamp'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.timestamp is string;
      allow read: if request.auth != null
        && request.auth.token.email == 'alanjohn9626@gmail.com';
      allow update, delete: if false;
    }
  }
}
